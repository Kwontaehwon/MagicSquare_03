# ================================================================================
project:
  name: MagicSquare
  description: 4x4 마방진 생성·검증·탐색 시스템 (Magic Constant = 34)
  language: Python
  python_version: "3.10+"
  methodology: Dual-Track TDD + ECB Architecture

# ================================================================================
code_style:
  python_version: "3.10+"
  style_guide: PEP8 엄격 준수
  formatter: Black
  max_line_length: 88
  type_hints:
    required: true
    scope: 모든 함수 파라미터와 반환값에 필수
    forbidden: "# type: ignore 사용 금지"
  docstring:
    style: Google
    scope: 모든 public 메서드와 public 클래스에 필수
    example: |
      def validate(grid: Grid) -> bool:
          """격자가 유효한 4x4 마방진인지 검증한다.

          Args:
              grid: 검증 대상 격자 객체.

          Returns:
              모든 행·열·대각선 합이 34이면 True.
          """

# ================================================================================
architecture:
  pattern: ECB (Entity-Control-Boundary)
  layers:
    boundary:
      role: 외부 입출력 담당 — 사용자·파일·CLI와의 접점
      responsibilities:
        - CLI 명령 파싱 및 결과 출력
        - 파일 입출력 (솔루션 저장·불러오기)
        - 화면 표시용 포맷 변환 (Formatter)
      allowed_imports: [control, entity]
      examples: [cli.py, file_io.py, formatter.py]

    control:
      role: 비즈니스 로직 담당 — 마방진 생성·검증·탐색 유즈케이스
      responsibilities:
        - 마방진 생성 알고리즘 (Solver, Generator)
        - 유효성 검증 로직 (Validator)
        - 탐색 전략 조율 (SearchController)
      allowed_imports: [entity]
      forbidden_imports: [boundary]
      examples: [solver.py, validator.py, generator.py]

    entity:
      role: 도메인 데이터 및 불변식 담당 — 순수 도메인 객체
      responsibilities:
        - Grid, Cell 도메인 객체 정의
        - Magic Constant(34) 등 도메인 상수
        - 도메인 규칙 (1~16 각 1회 사용, 합 = 34)
      allowed_imports: []
      forbidden_imports: [control, boundary]
      examples: [grid.py, cell.py, constants.py]

  dependency_direction: "boundary → control → entity (단방향, 역방향 import 금지)"

# ================================================================================
tdd_rules:
  red_phase:
    description: 실패하는 테스트를 먼저 작성하여 구현 목표를 명확히 한다
    rules:
      - 구현 코드 작성 전 반드시 테스트를 먼저 작성한다
      - pytest 실행 후 FAILED 상태를 직접 확인한 뒤 다음 단계로 진행한다
      - 테스트는 하나의 행동(behavior)만 검증한다
      - 테스트 실패 원인이 "구현 없음"임을 확인한다 (문법 오류로 인한 실패는 RED가 아님)
    must_not:
      - RED 확인 없이 구현 코드를 먼저 작성하는 행위
      - 여러 행동을 하나의 테스트에 묶는 행위
      - 통과가 보장된 테스트(항상 True)를 작성하는 행위

  green_phase:
    description: 테스트를 통과시키는 최소한의 코드만 작성한다
    rules:
      - 테스트를 통과시키는 가장 단순한 코드만 작성한다
      - 하드코딩·pass로 일시 통과해도 허용 (refactor_phase에서 반드시 제거)
      - 모든 기존 테스트가 여전히 통과하는지 확인한다
    must_not:
      - 이 단계에서 구조 개선·추상화·최적화를 수행하는 행위
      - 테스트 조건을 완화하거나 skip/xfail로 GREEN을 달성하는 행위
      - 테스트가 요구하지 않은 기능을 미리 구현하는 행위

  refactor_phase:
    description: 외부 동작을 유지하면서 내부 구조를 개선한다
    rules:
      - 리팩터링 전후 전체 테스트 스위트가 동일하게 통과해야 한다
      - 커버리지가 리팩터링 이전보다 낮아지면 안 된다
      - ECB 레이어 경계와 의존성 방향을 준수한다
    must_not:
      - 외부 동작(함수 시그니처·반환값·예외 타입)을 변경하는 행위
      - 테스트를 약화(assertion 제거·범위 축소)하여 커버리지를 맞추는 행위
      - green_phase에서 허용한 하드코딩을 그대로 남겨두는 행위

# ================================================================================
testing:
  framework: pytest
  pattern: AAA (Arrange-Act-Assert)
  coverage_minimum: "80%"
  naming_convention:
    file: "test_<모듈명>.py"
    function: "test_<상황>_<기대결과>"
    example: "test_validate_returns_true_when_magic_constant_is_34"
  fixture_scope:
    function: 기본값. 각 테스트마다 독립 상태 보장
    module: 생성 비용이 큰 픽스처 (ex. 전체 880개 해 집합)
    session: 읽기 전용 상수·설정 데이터에만 허용
  aaa_structure:
    arrange: 테스트 대상 객체·입력값·픽스처 준비
    act: 검증 대상 단일 행동 실행
    assert: 결과 검증 (assert 메시지에 실패 이유 명시)
    separator: 각 구역은 빈 줄로 구분

# ================================================================================
forbidden:
  - pattern: "print()"
    reason: 디버깅 흔적이 프로덕션 코드에 잔류하면 출력 부작용 발생
    alternative: "logging 모듈 사용 (logging.debug / logging.info)"

  - pattern: "매직 넘버 하드코딩 (예: 34, 16, 4를 코드 내 직접 사용)"
    reason: 도메인 상수가 분산되면 변경 시 누락 위험, 의미 파악 불가
    alternative: "entity/constants.py 의 MAGIC_CONSTANT, GRID_SIZE, MAX_VALUE 참조"

  - pattern: "except 단독 사용 (bare except:)"
    reason: 모든 예외를 무차별 포획하면 디버깅 불가, 시스템 예외(KeyboardInterrupt 등) 은닉
    alternative: "except SpecificError as e: 형태로 예외 타입 명시"

  - pattern: "타입힌트 없는 함수 정의"
    reason: 정적 분석 불가, 협업 시 계약 불명확
    alternative: "파라미터와 반환값 모두 타입힌트 명시"

  - pattern: "boundary에서 entity를 건너뛰고 직접 데이터 조작"
    reason: ECB 레이어 경계 위반, 도메인 불변식 우회 가능
    alternative: "control 레이어를 통해 entity 접근"

  - pattern: "테스트에서 assert 없이 통과 (빈 테스트 함수)"
    reason: 테스트 스위트가 실제 검증 없이 GREEN이 되어 안전망 붕괴
    alternative: "최소 1개의 assert 또는 pytest.raises로 명시적 검증"

# ================================================================================
file_structure:
  # magic_square/
  # ├── entity/                  # 도메인 객체·상수 (의존성 없음)
  # │   ├── __init__.py
  # │   ├── constants.py         # MAGIC_CONSTANT=34, GRID_SIZE=4, MAX_VALUE=16
  # │   ├── cell.py              # Cell 값 객체
  # │   └── grid.py              # Grid 도메인 객체
  # │
  # ├── control/                 # 비즈니스 로직 (entity만 import 허용)
  # │   ├── __init__.py
  # │   ├── validator.py         # MagicSquareValidator
  # │   ├── generator.py         # MagicSquareGenerator
  # │   └── solver.py            # BacktrackingSolver 등
  # │
  # ├── boundary/                # 외부 접점 (control·entity import 허용)
  # │   ├── __init__.py
  # │   ├── cli.py               # CLI 진입점
  # │   ├── formatter.py         # 격자 출력 포맷터
  # │   └── file_io.py           # 솔루션 저장·불러오기
  # │
  # ├── tests/
  # │   ├── entity/
  # │   │   ├── test_grid.py
  # │   │   └── test_cell.py
  # │   ├── control/
  # │   │   ├── test_validator.py
  # │   │   ├── test_generator.py
  # │   │   └── test_solver.py
  # │   └── boundary/
  # │       ├── test_cli.py
  # │       └── test_formatter.py
  # │
  # ├── pyproject.toml           # Black·pytest·mypy 설정
  # └── README.md
  root: magic_square/
  ecb_layers: [entity, control, boundary]
  test_mirror: true

# ================================================================================
ai_behavior:
  before_writing_code:
    - 관련 테스트 파일을 먼저 확인한다 (tests/ 디렉터리)
    - 현재 단계가 red/green/refactor 중 어느 phase인지 파악한다
    - 작성할 코드가 속할 ECB 레이어를 결정한다

  while_writing_code:
    - 모든 함수에 파라미터·반환값 타입힌트를 포함한다
    - 모든 public 메서드에 Google 스타일 docstring을 포함한다
    - ECB 레이어 경계를 위반하는 import를 생성하지 않는다
    - print() 대신 logging을 사용한다
    - 도메인 상수(34, 16, 4)를 직접 하드코딩하지 않는다

  after_writing_code:
    - tdd_rules 위반 여부를 자가 점검하고, 위반 시 사용자에게 경고한다
    - ECB 의존성 방향(boundary→control→entity)을 검토한다
    - 사용자에게 pytest 실행을 요청하여 RED/GREEN 상태를 확인하도록 안내한다

  warnings:
    - trigger: RED 없이 구현 코드를 생성하려는 경우
      message: "[TDD 경고] 테스트가 먼저 작성되지 않았습니다. RED 단계를 먼저 완료하세요."
    - trigger: 타입힌트 없는 함수를 생성하려는 경우
      message: "[타입힌트 경고] 파라미터 또는 반환값에 타입힌트가 없습니다."
    - trigger: 역방향 import 감지 (entity→control, entity→boundary, control→boundary)
      message: "[ECB 경고] 레이어 의존성 방향 위반입니다. boundary→control→entity 방향만 허용됩니다."
